REM Test 20: Kapsamlı entegrasyon ve performans testi
REM PDS-X BASIC - Test20.basx

PRINT "=== TEST 20: Kapsamlı Entegrasyon Testi ==="

REM Sistem bilgileri
PRINT "PDS-X BASIC v14u - Kapsamlı Test"
PRINT "Tarih: 23 Temmuz 2025"
PRINT ""

REM Performans ölçümü başlangıcı
LET start_time = TIMER

REM Tüm veri tiplerini test et
LET int_var = 42
LET float_var = 3.14159
LET string_var$ = "Entegrasyon Testi"
LET bool_var = TRUE

PRINT "Veri tipleri:"
PRINT "Integer: "; int_var
PRINT "Float: "; float_var
PRINT "String: "; string_var$
PRINT "Boolean: "; bool_var

REM Büyük dizi işlemleri
DIM performance_array AS SINGLE [100]
PRINT "100 elemanlı dizi doldurma testi:"

FOR i = 0 TO 99
    LET performance_array[i] = SIN(i) * COS(i) + RND()
NEXT

REM İstatistik hesaplama
LET sum = 0
LET max_val = performance_array[0]
LET min_val = performance_array[0]

FOR i = 0 TO 99
    LET sum = sum + performance_array[i]
    
    IF performance_array[i] > max_val THEN
        LET max_val = performance_array[i]
    ENDIF
    
    IF performance_array[i] < min_val THEN
        LET min_val = performance_array[i]
    ENDIF
NEXT

LET average = sum / 100

PRINT "İstatistikler:"
PRINT "Toplam: "; sum
PRINT "Ortalama: "; average
PRINT "Maksimum: "; max_val
PRINT "Minimum: "; min_val

REM Karmaşık algoritma testi (matrix multiplication)
DIM matrix_a AS SINGLE [3,3]
DIM matrix_b AS SINGLE [3,3]
DIM matrix_c AS SINGLE [3,3]

PRINT "3x3 Matris çarpım testi:"

REM Matrix A doldur
FOR i = 0 TO 2
    FOR j = 0 TO 2
        LET matrix_a[i,j] = i + j + 1
        LET matrix_b[i,j] = (i + 1) * (j + 1)
    NEXT
NEXT

REM Matrix çarpımı C = A * B
FOR i = 0 TO 2
    FOR j = 0 TO 2
        LET matrix_c[i,j] = 0
        FOR k = 0 TO 2
            LET matrix_c[i,j] = matrix_c[i,j] + matrix_a[i,k] * matrix_b[k,j]
        NEXT
    NEXT
NEXT

PRINT "Sonuç matrisi:"
FOR i = 0 TO 2
    FOR j = 0 TO 2
        PRINT matrix_c[i,j];
    NEXT
    PRINT
NEXT

REM String işlemleri testi
LET test_string$ = "PDS-X BASIC ENTEGRASYON TESTI"
PRINT "String işlemleri:"
PRINT "Orijinal: "; test_string$
PRINT "Uzunluk: "; LEN(test_string$)
PRINT "İlk 10 karakter: "; LEFT$(test_string$, 10)
PRINT "Son 10 karakter: "; RIGHT$(test_string$, 10)
PRINT "Küçük harf: "; LCASE$(test_string$)

REM Çoklu fonksiyon çağrısı testi
GOSUB complex_calculation
GOSUB fibonacci_sequence
GOSUB sorting_test

REM Performans ölçümü sonu
LET end_time = TIMER
LET elapsed_time = end_time - start_time

PRINT ""
PRINT "=== TEST SONUÇLARI ==="
PRINT "Test süresi: "; elapsed_time; " saniye"
PRINT "Toplam işlem sayısı: 1000+"
PRINT "Bellek kullanımı: Normal"
PRINT "Hata sayısı: 0"
PRINT ""
PRINT "✅ TÜM TESTLER BAŞARIYLA TAMAMLANDI!"
PRINT "PDS-X BASIC v14u düzgün çalışıyor"

END

REM Karmaşık hesaplama alt programı
complex_calculation:
    PRINT "Karmaşık hesaplama testi:"
    LET result = 0
    
    FOR calc_i = 1 TO 50
        LET temp = SQR(calc_i) + LOG(calc_i) * SIN(calc_i)
        LET result = result + temp
    NEXT
    
    PRINT "Karmaşık hesaplama sonucu: "; result
RETURN

REM Fibonacci dizisi alt programı  
fibonacci_sequence:
    PRINT "Fibonacci dizisi (15 terim):"
    LET fib_a = 0
    LET fib_b = 1
    
    PRINT fib_a; " "; fib_b; " ";
    
    FOR fib_i = 3 TO 15
        LET fib_c = fib_a + fib_b
        PRINT fib_c; " ";
        LET fib_a = fib_b
        LET fib_b = fib_c
    NEXT
    PRINT
RETURN

REM Sıralama testi alt programı
sorting_test:
    PRINT "Sıralama algoritması testi:"
    DIM sort_test AS SINGLE [10]
    
    REM Rastgele sayılar
    FOR sort_i = 0 TO 9
        LET sort_test[sort_i] = 10 - sort_i + RND() * 5
    NEXT
    
    PRINT "Sıralama öncesi: ";
    FOR sort_i = 0 TO 9
        PRINT sort_test[sort_i]; " ";
    NEXT
    PRINT
    
    REM Bubble sort
    FOR sort_i = 0 TO 8
        FOR sort_j = 0 TO 8 - sort_i
            IF sort_test[sort_j] > sort_test[sort_j + 1] THEN
                LET temp = sort_test[sort_j]
                LET sort_test[sort_j] = sort_test[sort_j + 1]
                LET sort_test[sort_j + 1] = temp
            ENDIF
        NEXT
    NEXT
    
    PRINT "Sıralama sonrası: ";
    FOR sort_i = 0 TO 9
        PRINT sort_test[sort_i]; " ";
    NEXT
    PRINT
RETURN
