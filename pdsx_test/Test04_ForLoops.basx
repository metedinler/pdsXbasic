REM Test 04: FOR döngüleri
REM PDS-X BASIC - Test04.basx

PRINT "=== TEST 04: FOR Döngüleri ==="

REM Basit FOR döngüsü
PRINT "1'den 5'e kadar sayılar:"
FOR i = 1 TO 5
    PRINT "i ="; i
NEXT

REM STEP ile FOR döngüsü
PRINT "0'dan 10'a 2'şer artırarak:"
FOR j = 0 TO 10 STEP 2
    PRINT "j ="; j
NEXT

REM Geriye doğru sayma
PRINT "10'dan 1'e geriye sayım:"
FOR k = 10 TO 1 STEP -1
    PRINT "k ="; k
NEXT

REM İç içe FOR döngüleri
PRINT "Çarpım tablosu (3x3):"
FOR row = 1 TO 3
    FOR col = 1 TO 3
        LET result = row * col
        PRINT row; "x"; col; "="; result
    NEXT
NEXT

REM Dizi elemanlarını doldurma
DIM numbers AS SINGLE [5]
FOR index = 0 TO 4
    LET numbers[index] = index * 2
NEXT

PRINT "Dizi elemanları:"
FOR index = 0 TO 4
    PRINT "numbers["; index; "] ="; numbers[index]
NEXT

PRINT "Test 04 tamamlandı!"
END
